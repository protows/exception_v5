package exception.v4.validators;
import exception.v4.exceptions.ValidateException;
import exception.v4.exceptions.ValidatePasswordException;

public class PasswordLengthValidator implements IValidator {
    private final int minLength;

    public PasswordLengthValidator(final int minLength) {
        this.minLength = minLength;
    }

    @Override
    public void validate(final String password) throws ValidateException {
        if (password == null || password.length() < minLength) {
            throw new ValidatePasswordException(
                    String.format("Пароль должен быть больше %d символов", minLength), password
            );
        }
    }
}
